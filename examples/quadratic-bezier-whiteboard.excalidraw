    {"type":"text","id":"board2title","x":835,"y":163,"width":200,"height":25,"text":"2. 参数方程","originalText":"2. 参数方程","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5021,"version":1,"versionNonce":6021,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"formulaBox","x":860,"y":215,"width":420,"height":95,"strokeColor":"#6d28d9","backgroundColor":"#f5f3ff","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5022,"version":1,"versionNonce":6022,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"formulaText","x":892,"y":245,"width":355,"height":38,"text":"B(t) = (1-t)²P0 + 2(1-t)tP1 + t²P2\n其中 0 ≤ t ≤ 1","originalText":"B(t) = (1-t)²P0 + 2(1-t)tP1 + t²P2\n其中 0 ≤ t ≤ 1","fontSize":24,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5023,"version":1,"versionNonce":6023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"formulaNote","x":875,"y":318,"width":390,"height":22,"text":"看法：三个点做加权平均，权重随 t 变化，且三项权重和始终为 1","originalText":"看法：三个点做加权平均，权重随 t 变化，且三项权重和始终为 1","fontSize":17,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5024,"version":1,"versionNonce":6024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"board3","x":800,"y":390,"width":540,"height":210,"strokeColor":"#1e3a5f","backgroundColor":"#f8fafc","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5025,"version":1,"versionNonce":6025,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"board3title","x":835,"y":408,"width":240,"height":25,"text":"3. 几何意义（白话版）","originalText":"3. 几何意义（白话版）","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5026,"version":1,"versionNonce":6026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"meaning1","x":855,"y":455,"width":420,"height":110,"text":"• t=0 时，B(t)=P0，曲线从起点出发\n• t=1 时，B(t)=P2，曲线到终点结束\n• P1 不一定在曲线上，但它会“拉拽”曲线方向\n• 起点切线方向沿 P0→P1\n• 终点切线方向沿 P1→P2","originalText":"• t=0 时，B(t)=P0，曲线从起点出发\n• t=1 时，B(t)=P2，曲线到终点结束\n• P1 不一定在曲线上，但它会“拉拽”曲线方向\n• 起点切线方向沿 P0→P1\n• 终点切线方向沿 P1→P2","fontSize":20,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5027,"version":1,"versionNonce":6027,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"board4","x":55,"y":625,"width":1285,"height":250,"strokeColor":"#1e3a5f","backgroundColor":"#f8fafc","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5028,"version":1,"versionNonce":6028,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"board4title","x":90,"y":643,"width":310,"height":25,"text":"4. De Casteljau 构造步骤 + 应用","originalText":"4. De Casteljau 构造步骤 + 应用","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5029,"version":1,"versionNonce":6029,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"casteljau","x":100,"y":700,"width":640,"height":110,"text":"Step 1：在 P0P1 上按比例 t 取点 Q0\nStep 2：在 P1P2 上按比例 t 取点 Q1\nStep 3：再在 Q0Q1 上按同比例 t 取点 B(t)\n当 t 从 0 连续变化到 1，B(t) 就扫出整条二次贝塞尔曲线。","originalText":"Step 1：在 P0P1 上按比例 t 取点 Q0\nStep 2：在 P1P2 上按比例 t 取点 Q1\nStep 3：再在 Q0Q1 上按同比例 t 取点 B(t)\n当 t 从 0 连续变化到 1，B(t) 就扫出整条二次贝塞尔曲线。","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5030,"version":1,"versionNonce":6030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"appbox","x":815,"y":690,"width":460,"height":120,"strokeColor":"#047857","backgroundColor":"#ecfdf5","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5031,"version":1,"versionNonce":6031,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"apptext","x":850,"y":718,"width":390,"height":64,"text":"常见应用：\n• SVG / Canvas 路径绘制\n• UI 曲线、气泡尾巴、转场轨迹\n• 字形轮廓与矢量图形\n• 游戏中的平滑运动路径","originalText":"常见应用：\n• SVG / Canvas 路径绘制\n• UI 曲线、气泡尾巴、转场轨迹\n• 字形轮廓与矢量图形\n• 游戏中的平滑运动路径","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5032,"version":1,"versionNonce":6032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"summary","x":160,"y":905,"width":1070,"height":108,"strokeColor":"#1e3a5f","backgroundColor":"#dbeafe","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5033,"version":1,"versionNonce":6033,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"summarytext","x":210,"y":935,"width":970,"height":48,"text":"一句话记忆：二次贝塞尔 = 3 个点 + 1 个参数 t，用“线性插值套线性插值”得到一条平滑曲线。\n最关键的不是 P1 在不在曲线上，而是它如何决定曲线的弯曲方向与弯曲强度。","originalText":"一句话记忆：二次贝塞尔 = 3 个点 + 1 个参数 t，用“线性插值套线性插值”得到一条平滑曲线。\n最关键的不是 P1 在不在曲线上，而是它如何决定曲线的弯曲方向与弯曲强度。","fontSize":22,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":5034,"version":1,"versionNonce":6034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
  ],
