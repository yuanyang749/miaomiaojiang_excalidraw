    {"type":"text","id":"title","x":285,"y":30,"width":780,"height":44,"text":"一页讲清：二元一次方程（讲义风）","originalText":"一页讲清：二元一次方程（讲义风）","fontSize":30,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7001,"version":1,"versionNonce":8001,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"subtitle","x":270,"y":76,"width":810,"height":24,"text":"核心理解：含有两个未知数，并且每个未知数的次数都是 1；它在平面直角坐标系中对应一条直线","originalText":"核心理解：含有两个未知数，并且每个未知数的次数都是 1；它在平面直角坐标系中对应一条直线","fontSize":17,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7002,"version":1,"versionNonce":8002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

