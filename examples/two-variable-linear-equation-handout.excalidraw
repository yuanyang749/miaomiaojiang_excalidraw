    {"type":"text","id":"formula1text","x":160,"y":228,"width":180,"height":28,"text":"ax + by = c","originalText":"ax + by = c","fontSize":28,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#6d28d9","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7006,"version":1,"versionNonce":8006,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"box1body","x":82,"y":288,"width":300,"height":48,"text":"其中 x、y 是未知数；\na、b、c 是常数，且 a、b 不同时为 0。","originalText":"其中 x、y 是未知数；\na、b、c 是常数，且 a、b 不同时为 0。","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7007,"version":2,"versionNonce":9007,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"box2","x":475,"y":135,"width":390,"height":205,"strokeColor":"#6b5b95","backgroundColor":"#f5efff","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":7008,"version":1,"versionNonce":8008,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"box2title","x":505,"y":155,"width":190,"height":25,"text":"2. 为什么叫“一次”","originalText":"2. 为什么叫“一次”","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7009,"version":1,"versionNonce":8009,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"box2body","x":515,"y":205,"width":300,"height":92,"text":"• “二元” = 有两个未知数 x、y\n• “一次” = x 和 y 的最高次数都是 1\n• 不能出现 x²、y²、xy、√x 这类项\n• 例如：2x+3y=6 是，x²+y=4 不是","originalText":"• “二元” = 有两个未知数 x、y\n• “一次” = x 和 y 的最高次数都是 1\n• 不能出现 x²、y²、xy、√x 这类项\n• 例如：2x+3y=6 是，x²+y=4 不是","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7010,"version":1,"versionNonce":8010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"box3","x":895,"y":135,"width":390,"height":205,"strokeColor":"#2f6f5e","backgroundColor":"#eefcf6","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":7011,"version":1,"versionNonce":8011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"box3title","x":925,"y":155,"width":210,"height":25,"text":"3. 解的含义","originalText":"3. 解的含义","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7012,"version":1,"versionNonce":8012,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"box3body","x":935,"y":205,"width":300,"height":96,"text":"满足方程的每一组 (x, y) 都叫它的一个解。\n\n例如：\n对于 x + y = 5\n(1,4)、(2,3)、(0,5) 都是解。","originalText":"满足方程的每一组 (x, y) 都叫它的一个解。\n\n例如：\n对于 x + y = 5\n(1,4)、(2,3)、(0,5) 都是解。","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7013,"version":1,"versionNonce":8013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

