    {"type":"text","id":"graphlabel","x":270,"y":430,"width":250,"height":22,"text":"例：x + 2y = 6 的图像是一条直线","originalText":"例：x + 2y = 6 的图像是一条直线","fontSize":18,"fontFamily":3,"textAlign":"center","verticalAlign":"top","strokeColor":"#dc2626","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7024,"version":1,"versionNonce":8024,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"pointlabels","x":455,"y":500,"width":155,"height":74,"text":"直线上的点\n(0,3)\n(2,2)\n(4,1)","originalText":"直线上的点\n(0,3)\n(2,2)\n(4,1)","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7025,"version":1,"versionNonce":8025,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"graphnote","x":92,"y":680,"width":500,"height":48,"text":"图像上的每一个点，都对应方程的一个解；\n反过来，每个解都落在这条直线上。","originalText":"图像上的每一个点，都对应方程的一个解；\n反过来，每个解都落在这条直线上。","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7026,"version":2,"versionNonce":9026,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"box5","x":710,"y":375,"width":575,"height":170,"strokeColor":"#6b5b95","backgroundColor":"#f6f1ff","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":7027,"version":1,"versionNonce":8027,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"box5title","x":740,"y":395,"width":220,"height":25,"text":"5. 常见变形","originalText":"5. 常见变形","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7028,"version":1,"versionNonce":8028,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"box5body","x":750,"y":440,"width":500,"height":78,"text":"一般式：ax + by = c\n斜截式：y = kx + b（当 b≠0 且可化成 y=... 时）\n截距式：x/a + y/b = 1（知道与坐标轴交点时很方便）","originalText":"一般式：ax + by = c\n斜截式：y = kx + b（当 b≠0 且可化成 y=... 时）\n截距式：x/a + y/b = 1（知道与坐标轴交点时很方便）","fontSize":19,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7029,"version":1,"versionNonce":8029,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"box6","x":710,"y":565,"width":575,"height":170,"strokeColor":"#2f6f5e","backgroundColor":"#eefaf4","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":7030,"version":1,"versionNonce":8030,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"box6title","x":740,"y":585,"width":260,"height":25,"text":"6. 和“二元一次方程组”的关系","originalText":"6. 和“二元一次方程组”的关系","fontSize":22,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7031,"version":1,"versionNonce":8031,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"box6body","x":750,"y":630,"width":490,"height":76,"text":"一个二元一次方程对应一条直线。\n两个二元一次方程联立，就是看两条直线：\n• 相交：一个解  • 平行：无解  • 重合：无数组解","originalText":"一个二元一次方程对应一条直线。\n两个二元一次方程联立，就是看两条直线：\n• 相交：一个解  • 平行：无解  • 重合：无数组解","fontSize":19,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7032,"version":1,"versionNonce":8032,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"rectangle","id":"summary","x":150,"y":770,"width":1040,"height":120,"strokeColor":"#7c5a2b","backgroundColor":"#fff1cc","fillStyle":"hachure","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"seed":7033,"version":1,"versionNonce":8033,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"summarytext","x":200,"y":805,"width":940,"height":52,"text":"一句话记忆：二元一次方程 = 两个未知数、一次、图像是一条直线。\n最重要的两层理解：代数上看是“满足等式的数对”，几何上看是“平面上的一条直线”。","originalText":"一句话记忆：二元一次方程 = 两个未知数、一次、图像是一条直线。\n最重要的两层理解：代数上看是“满足等式的数对”，几何上看是“平面上的一条直线”。","fontSize":22,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":7034,"version":1,"versionNonce":8034,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25}
